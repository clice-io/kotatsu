load("//bazel:defs.bzl", "kotatsu_library")

# For the tests: the npm packages the integration tests import, and the LSP
# metamodel the LSP ones read.
exports_files([
    "MODULE.bazel",
    "package-lock.json",
    "package.json",
    "scripts/lsp/metaModel.json",
    "scripts/lsp/metamodel.ts",
])

# One target per module of include/kotatsu (and per codec backend, each with its
# third-party library), as CMake's kotatsu::<module> targets. Each owns its
# headers alone, so that a module can become a C++20 module as it stands.
# HTTP (libcurl) is CMake's only, for now.

kotatsu_library(
    name = "support",
    srcs = ["src/support/glob_pattern.cpp"],
    hdrs = glob(["include/kotatsu/support/**"]),
)

# One object per area: a program links only those it calls into, and on
# Windows imports only their DLLs (catter's hook library, which runs in every
# process a build starts, takes the environment and program lookup without the
# rest). ntdll for parent_pid, parallelism, cpu_cores and os; advapi32 for
# the registry of cpu_cores; shell32 and ole32 for the known folders of dirs.
kotatsu_library(
    name = "sys",
    srcs = glob([
        "src/sys/*.cpp",
        "src/sys/*.h",
    ]),
    hdrs = glob(["include/kotatsu/sys/**"]),
    # pthread_sigmask around spawn's fork, in libc itself only from glibc 2.34.
    linkopts = select({
        "@platforms//os:windows": [
            "-ladvapi32",
            "-lntdll",
            "-lole32",
            "-lshell32",
        ],
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    deps = [
        ":fs",
        ":support",
    ],
)

kotatsu_library(
    name = "fs",
    srcs = glob([
        "src/fs/*.cpp",
        "src/fs/*.h",
    ]),
    hdrs = glob(["include/kotatsu/fs/**"]),
    deps = [":support"],
)

kotatsu_library(
    name = "meta",
    hdrs = glob(["include/kotatsu/meta/**"]),
    deps = [":support"],
)

kotatsu_library(
    name = "codec",
    hdrs = ["include/kotatsu/codec/macro.h"] + glob([
        "include/kotatsu/codec/bincode/**",
        "include/kotatsu/codec/blob/**",
        "include/kotatsu/codec/debug/**",
        "include/kotatsu/codec/dyn/**",
        "include/kotatsu/codec/visit/**",
    ]),
    deps = [
        ":meta",
        ":support",
    ],
)

kotatsu_library(
    name = "codec_json",
    hdrs = glob(["include/kotatsu/codec/json/**"]),
    deps = [
        ":codec",
        "@simdjson",
    ],
)

kotatsu_library(
    name = "codec_toml",
    hdrs = glob(["include/kotatsu/codec/toml/**"]),
    # kotatsu/codec/toml/type.h requires toml++ without exceptions, whatever
    # kotatsu's own setting.
    defines = ["TOML_EXCEPTIONS=0"],
    deps = [
        ":codec",
        "@tomlplusplus",
    ],
)

kotatsu_library(
    name = "codec_flatbuffers",
    hdrs = glob(["include/kotatsu/codec/fbs/**"]),
    deps = [
        ":codec",
        "@flatbuffers",
    ],
)

kotatsu_library(
    name = "option",
    srcs = glob(["src/deco/option/*.cc"]),
    hdrs = ["include/kotatsu/deco/option.h"] + glob(["include/kotatsu/deco/option/**"]),
    deps = [":support"],
)

kotatsu_library(
    name = "deco",
    srcs = glob(["src/deco/facade/*.cc"]),
    hdrs = [
        "include/kotatsu/deco/deco.h",
        "include/kotatsu/deco/macro.h",
    ] + glob(["include/kotatsu/deco/facade/**"]),
    deps = [
        ":meta",
        ":option",
        ":support",
    ],
)

kotatsu_library(
    name = "async",
    srcs = glob([
        "src/async/**/*.cpp",
        "src/async/**/*.h",
    ]),
    hdrs = glob(["include/kotatsu/async/**"]),
    deps = [
        ":fs",
        ":support",
        ":sys",
        "@libuv",
    ],
)

# The LSP base protocol's framing, the protocol model, the bincode codec and
# the blocking client, without the event loop: a program that only reads and
# writes messages, such as catter's hook library, which runs in every process a
# build starts, takes neither libuv nor the DLLs it imports.
kotatsu_library(
    name = "ipc_codec",
    srcs = [
        "src/ipc/blocking_client.cpp",
        "src/ipc/codec/bincode.cpp",
        "src/ipc/framing.cpp",
    ],
    hdrs = [
        "include/kotatsu/ipc/blocking_client.h",
        "include/kotatsu/ipc/codec.h",
        "include/kotatsu/ipc/codec/bincode.h",
        "include/kotatsu/ipc/framing.h",
        "include/kotatsu/ipc/protocol.h",
    ],
    deps = [
        ":codec",
        ":support",
    ],
)

# The JSON codec, without the event loop: CMake builds it into
# kotatsu::ipc::codec when simdjson is enabled.
kotatsu_library(
    name = "ipc_codec_json",
    srcs = ["src/ipc/codec/json.cpp"],
    hdrs = ["include/kotatsu/ipc/codec/json.h"],
    deps = [
        ":codec",
        ":codec_json",
        ":ipc_codec",
        ":support",
    ],
)

kotatsu_library(
    name = "ipc",
    srcs = [
        "src/ipc/peer/bincode.cpp",
        "src/ipc/recording_transport.cpp",
        "src/ipc/transport.cpp",
    ],
    hdrs = [
        "include/kotatsu/ipc/logger.h",
        "include/kotatsu/ipc/peer.h",
        "include/kotatsu/ipc/peer.inl",
        "include/kotatsu/ipc/peer/bincode.h",
        "include/kotatsu/ipc/recording_transport.h",
        "include/kotatsu/ipc/transport.h",
    ],
    deps = [
        ":async",
        ":codec",
        ":ipc_codec",
        ":support",
    ],
)

# JSON-RPC over ipc, on the JSON codec: CMake builds it into kotatsu::ipc when
# simdjson is enabled.
kotatsu_library(
    name = "ipc_json",
    srcs = ["src/ipc/peer/json.cpp"],
    hdrs = ["include/kotatsu/ipc/peer/json.h"],
    deps = [
        ":ipc",
        ":ipc_codec_json",
    ],
)

kotatsu_library(
    name = "ipc_lsp",
    srcs = glob([
        "src/ipc/lsp/*.cpp",
        "src/ipc/lsp/*.h",
    ]),
    hdrs = glob(["include/kotatsu/ipc/lsp/**"]),
    deps = [
        ":codec",
        ":ipc",
        ":ipc_codec",
        ":meta",
        ":support",
    ],
)

kotatsu_library(
    name = "zest",
    srcs = glob([
        "src/zest/*.cpp",
        "src/zest/*.h",
    ]),
    hdrs = glob(
        ["include/kotatsu/zest/**"],
        exclude = ["include/kotatsu/zest/async.h"],
    ),
    deps = [
        ":async",
        ":codec",
        ":deco",
        ":fs",
        ":meta",
        ":support",
        ":sys",
        "@cpptrace",
    ],
)

# zest's support for tests of kotatsu::async code, as CMake's kotatsu::zest::async.
kotatsu_library(
    name = "zest_async",
    hdrs = ["include/kotatsu/zest/async.h"],
    deps = [
        ":async",
        ":zest",
    ],
)
