# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff

# Snapshot test files must use LF to avoid CRLF mismatch on Windows
*.snap eol=lf

# C++ sources too: raw string literals keep the checkout's line endings, and
# clang's -E output (xmake's build cache) doubles the CR of a CRLF one on
# Windows, so expected strings and generated text differ from Linux.
*.cpp text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.inl text eol=lf

# The pinned LSP metaModel, checked byte for byte against its sha256
scripts/lsp/metaModel.json -text linguist-vendored -diff
