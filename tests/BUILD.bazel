load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:command_test.bzl", "command_test")
load("//bazel:defs.bzl", "kotatsu_binary", "kotatsu_test")

# The tests of each module, as tests/CMakeLists.txt lays them out, but a test
# binary per module and level rather than one per level: a change to a module
# reruns only the tests of the modules above it. Every test includes what the
# tests share relative to tests/.

cc_library(
    name = "fixtures",
    hdrs = glob(["fixtures/*.h"]),
    strip_include_prefix = "/tests",
    deps = [
        "//:codec",
        "//:meta",
        "//:support",
    ],
)

# Each module's harness/, with what it builds on.
[cc_library(
    name = module.replace("/", "_") + "_harness",
    hdrs = glob(
        ["%s/harness/**/*.h" % module],
        allow_empty = True,
    ),
    strip_include_prefix = "/tests",
    textual_hdrs = glob(
        ["%s/harness/**/*.inc" % module],
        allow_empty = True,
    ),
    deps = deps + ["//:zest"],
) for module, deps in [
    ("support", ["//:support"]),
    ("fs", ["//:fs"]),
    ("sys", [
        ":fs_harness",
        "//:sys",
    ]),
    ("async", [
        ":fs_harness",
        ":support_harness",
        ":sys_harness",
        "//:async",
    ]),
    ("codec", [
        ":fixtures",
        "//:codec",
    ]),
    ("codec/bincode", [":codec_harness"]),
    ("codec/blob", ["//:codec"]),
    ("codec/dyn", [":codec_harness"]),
    ("codec/fbs", [
        ":codec_harness",
        "//:codec_flatbuffers",
    ]),
    ("codec/json", [
        ":codec_harness",
        "//:codec_json",
    ]),
    ("codec/toml", [
        ":codec_harness",
        "//:codec_toml",
    ]),
    ("cli", ["//:cli"]),
    ("ipc", [
        ":async_harness",
        "//:codec_json",
        "//:ipc",
        "//:ipc_json",
        "//:zest_async",
    ]),
    ("ipc/lsp", ["//:ipc_lsp"]),
]]

# <module>_unit_tests and <module>_system_tests, run from the repository root
# of the runfiles as ctest runs them, with the module's snapshots.
[kotatsu_test(
    name = "%s_%s_tests" % (module.replace("/", "_"), level),
    size = "medium",
    srcs = ["main.cpp"] + glob(["%s/%s/**/*.cpp" % (module, level)]),
    args = ["--snapshot-dir=tests/snapshots"],
    # The module's snapshots, and the files its tests read beside them.
    data = glob(
        [
            "snapshots/%s_*/**" % module.replace("/", "_"),
            "%s/%s/**" % (module, level),
        ],
        allow_empty = True,
        exclude = ["**/*.cpp"],
    ),
    # zest's snapshot cases rewrite a snapshot of tests/snapshots and put it
    # back, as under ctest, which a sandbox's read-only runfiles refuse.
    tags = [level] + (["no-sandbox"] if module == "zest" else []),
    deps = deps + ["//:zest"],
) for module, level, deps in [
    ("support", "unit", [":support_harness"]),
    ("fs", "unit", ["//:fs"]),
    ("fs", "system", [":fs_harness"]),
    ("sys", "unit", [":sys_harness"]),
    ("sys", "system", [":sys_harness"]),
    ("meta", "unit", [":fixtures"]),
    ("codec", "unit", [":codec_harness"]),
    ("codec/bincode", "unit", [":codec_bincode_harness"]),
    ("codec/blob", "unit", [":codec_blob_harness"]),
    ("codec/debug", "unit", [":codec_harness"]),
    ("codec/dyn", "unit", [":codec_dyn_harness"]),
    ("codec/fbs", "unit", [":codec_fbs_harness"]),
    ("codec/json", "unit", [":codec_json_harness"]),
    ("codec/toml", "unit", [":codec_toml_harness"]),
    ("cli", "unit", [":cli_harness"]),
    ("cli", "system", [":cli_harness"]),
    ("async", "unit", [
        ":async_harness",
        "//:zest_async",
    ]),
    ("async", "system", [
        ":async_harness",
        "//:zest_async",
    ]),
    ("ipc", "unit", [":ipc_harness"]),
    ("ipc", "system", [":ipc_harness"]),
    ("ipc/lsp", "unit", [
        ":ipc_harness",
        ":ipc_lsp_harness",
    ]),
    ("zest", "unit", [
        ":async_harness",
        "//:zest_async",
    ]),
    ("zest", "system", []),
    ("examples/async", "unit", [
        "//:zest_async",
        "//examples:build_system_graph",
    ]),
]]

# The ipc codecs and the blocking client built into a program alone, without
# the event loop: see ipc/codec_alone/main.cpp. Its client talks over a pipe or
# a socket.
kotatsu_test(
    name = "ipc_codec_alone",
    size = "small",
    srcs = ["ipc/codec_alone/main.cpp"],
    tags = ["system"],
    deps = [
        "//:ipc_codec",
        "//:ipc_codec_json",
    ],
)

# remove_all() with each allocation it makes failing in turn: see
# fs/remove_all_bad_alloc/main.cpp. Built where its walk holds descriptors
# (POSIX) and an allocation can throw, but for TSan, whose runtime defines the
# operator new it replaces.
kotatsu_test(
    name = "fs_remove_all_bad_alloc",
    size = "small",
    srcs = ["fs/remove_all_bad_alloc/main.cpp"],
    tags = ["system"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }) + select({
        "//bazel:no_exceptions": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }) + select({
        "//bazel:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//:fs"],
)

# copy_file() and rename_noreplace() where the system calls they start with
# fail: see fs/syscall_fallbacks/main.cpp. A filter of system calls is Linux's.
kotatsu_test(
    name = "fs_syscall_fallbacks",
    size = "small",
    srcs = ["fs/syscall_fallbacks/main.cpp"],
    # Its races' threads, in libc itself only from glibc 2.34.
    linkopts = ["-lpthread"],
    tags = ["system"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//:fs"],
)

# A relay let go while its loop winds down: see
# async/relay_release/main.cpp. The linker's --wrap is ELF's.
kotatsu_test(
    name = "async_relay_release",
    size = "small",
    srcs = ["async/relay_release/main.cpp"],
    # Its thread, in libc itself only from glibc 2.34.
    linkopts = [
        "-Wl,--wrap=uv_async_send",
        "-lpthread",
    ],
    tags = ["system"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//:async"],
)

# The integration tests' drivers: integration/drivers/<name>.cpp of a module,
# or the sources in integration/drivers/<name>/ for a driver too heavy for one
# translation unit.
[kotatsu_binary(
    name = driver,
    srcs = glob(
        [
            "%s/integration/drivers/%s.cpp" % (module, driver),
            "%s/integration/drivers/%s/*" % (module, driver),
        ],
        allow_empty = True,
    ),
    # sys_probe's sigaction finds libc's through dlsym, in libdl before glibc
    # 2.34.
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }) if driver == "sys_probe" else [],
    # One translation unit instantiating the codec for every LSP type: about
    # 2 minutes and 2.7 GB in a debug build, far more optimized or sanitized.
    tags = ["manual"] if driver == "lsp_roundtrip" else [],
    deps = deps,
) for module, deps, drivers in [
    ("sys", ["//:sys"], ["sys_probe"]),
    ("ipc", [":ipc_harness"], [
        "jsonrpc_driver",
        "stdio_close",
    ]),
    ("ipc/lsp", [
        ":ipc_harness",
        ":ipc_lsp_harness",
    ], [
        "lsp_probe",
        "lsp_roundtrip",
        "lsp_stub_server",
    ]),
] for driver in drivers]

# zest's own runner, checked end to end by zest/integration/check_runner.cmake.
kotatsu_binary(
    name = "zest_runner_fixture",
    srcs = ["zest/integration/runner_fixture.cpp"],
    # On Windows it links with garbage collection, as tests/zest/CMakeLists.txt
    # says why.
    copts = select({
        "@platforms//os:windows": [
            "-ffunction-sections",
            "-fdata-sections",
        ],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:windows": ["-Wl,--gc-sections"],
        "//conditions:default": [],
    }),
    deps = [
        "//:zest",
        "//:zest_async",
    ],
)

# zest's runner end to end, against tests that crash, hang, exit early or fail
# a ZASSERT and against crash tests; run_cli()'s command line on zest's unit
# tests.
command_test(
    name = "zest_runner_test",
    command = [
        "cmake",
        "-DFIXTURE=${FIXTURE}",
        "-DCLI=${CLI}",
        "-DWORK_DIR=${TEST_TMPDIR}/zest_runner",
        "-P",
        "tests/zest/integration/check_runner.cmake",
    ],
    data = [
        "zest/integration/check_runner.cmake",
        ":zest_runner_fixture",
        ":zest_unit_tests",
    ],
    env = {
        "CLI": "$(rootpath :zest_unit_tests)",
        "FIXTURE": "$(rootpath :zest_runner_fixture)",
    },
)

# A module's integration/*.test.ts, which node runs from the source tree as
# ctest does (`pixi run npm-ci` installs their npm packages there), each
# program named in KOTATSU_<NAME>, with the files they read beyond tests/.
[command_test(
    name = module.replace("/", "_") + "_integration",
    size = "large",
    command = [
        "node",
        "--import",
        "./tests/check_npm_packages.ts",
        "--test",
        "--test-reporter=spec",
        "--test-timeout=20000",
    ] + ["tests/" + test for test in glob(
        ["%s/integration/*.test.ts" % module],
        exclude = exclude,
    )],
    data = programs + glob(
        ["**/*.ts"],
        exclude = [
            "benchmarks/**",
            "conformance/**",
        ],
    ) + [
        "//:package-lock.json",
        "//:package.json",
    ] + files,
    env = {
        "KOTATSU_" + program.split(":")[-1].upper(): "$(rootpath %s)" % program
        for program in programs
    },
    source_tree = True,
    tags = ["integration"],
) for module, programs, exclude, files in [
    ("sys", [":sys_probe"], [], []),
    ("ipc", [
        ":jsonrpc_driver",
        ":stdio_close",
    ], [], []),
    # roundtrip.test.ts needs lsp_roundtrip, a debug build's only.
    ("ipc/lsp", [
        ":lsp_probe",
        ":lsp_stub_server",
    ], ["ipc/lsp/integration/roundtrip.test.ts"], [
        "//:scripts/lsp/metaModel.json",
        "//:scripts/lsp/metamodel.ts",
    ]),
    ("examples/async", [
        "//examples:async_basics",
        "//examples:dump_dot",
    ], [], []),
    ("examples/ipc", [
        "//examples:jsonrpc_roundtrip",
        "//examples:jsonrpc_server",
        "//examples:spawn_worker",
    ], [], []),
]]
